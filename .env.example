# This reading site. Run it on a different port from the Content Studio.
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Content Studio connection. The key must match the studio when it is set.
CMS_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3000"
CONTENT_API_KEY=""

# Reader accounts for this site only
DATABASE_URL="mongodb://localhost:27017/blogged"

# Contact mail. Leave unset until a mailbox is configured.
EMAIL_SERVER=""
EMAIL_PORT="465"
EMAIL_ADDRESS=""
EMAIL_PASSWORD=""
EMAIL_NAME="BloggED"
CONTACT_TO_EMAIL=""
